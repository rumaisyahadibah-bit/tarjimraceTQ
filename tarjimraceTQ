 for(let y=hz+1;y<H;y+=2){const s=(y-hz)/(H-hz),zr=Z0/s,zw=G.z-8+zr,st=Math.floor(zw/6)&1,c=W/2+sh(zw)-camX*RB*s,rw=s*RB;
