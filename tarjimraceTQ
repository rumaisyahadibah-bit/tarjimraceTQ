 cx.fillStyle="#ffffffcc";[[.15,.2],[.45,.12],[.7,.28],[.9,.15]].forEach(([a,b],i)=>{const x=((a*W+t*6*(1+i*.2))%(W+160))-80,y=hz*b+10;[[0,0,38,16],[-26,6,28,12],[28,5,30,12]].forEach(([dx,dy,rx,ry])=>{cx.beginPath();cx.ellipse(x+dx,y+dy,rx,ry,0,0,7);cx.fill()})});
