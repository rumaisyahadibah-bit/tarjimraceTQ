function burst(n,cxp,cyp){for(let i=0;i<n;i++)P.push({x:cxp,y:cyp,vx:(Math.random()-.5)*420,vy:-Math.random()*380-60,l:1,c:["#ffd54a","#fff","#7be3a0","#b6ffd0"][i%4],s:12+Math.random()*16})}
const K={left:false,right:false,tx:null};
function update(dt){
 G.t+=dt;G.shake=Math.max(0,G.shake-dt);G.flash=Math.max(0,G.flash-dt*1.6);
 if(G.st=="count"){G.cd-=dt;const n=Math.ceil(G.cd-.2);if(n!=G.lastN){G.lastN=n;if(n>0){$("#cd").textContent=n;sTick(440)}else{$("#cd").textContent="GO!";sTick(880)}}if(G.cd<=0){G.st="run";$("#cd").style.display="none"}return}
 if(G.st!="run")return;
 let d=(K.left?-1:0)+(K.right?1:0);if(!d&&K.tx!==null){const e=K.tx-G.x;d=Math.abs(e)>.06?Math.sign(e):0}
 G.x=clamp(G.x+d*1.8*dt,-1,1);G.lean+=(d-G.lean)*Math.min(1,dt*8);
 G.boost=Math.max(0,G.boost-dt);G.slow=Math.max(0,G.slow-dt);
 const tg=G.boost>0?40:G.slow>0?11:21;G.v+=(tg-G.v)*Math.min(1,dt*(G.boost>0?4:2.2));
 const pz=G.z;G.z+=G.v*dt;G.el+=dt;
 const g=G.gates[G.gi];
 if(g){const dist=g.z-G.z;if(dist<175&&!g.shown){g.shown=true;showQ(g)}
  if(pz<g.z&&G.z>=g.z)hitGate(g)}
 if(G.z>=FIN)finish();
 if(G.boost>0&&Math.random()<.6)P.push({x:W/2+(Math.random()-.5)*160,y:H*.85,vx:(Math.random()-.5)*60,vy:-80-Math.random()*100,l:.7,c:"#fff",s:8});
