  if(th.water){const k=Math.floor(zw/2.5)+(y>>1),h=(Math.imul(k,2654435761)>>>0)%100;if(h<9){cx.fillStyle="#ffffff38";const x0=(h*131+k*17)%W;cx.fillRect(x0,y,30*s+8,2)}}
